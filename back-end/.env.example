DATABASE_URL=mysql+pymysql://gia_su_ai:gia_su_ai_dev@localhost:3306/gia_su_ai?charset=utf8mb4
# Nếu dùng MySQL đã cài trên máy, thay user/mật khẩu ở trên bằng tài khoản của bạn.
# Ví dụ: mysql+pymysql://root:your_password@localhost:3306/gia_su_ai?charset=utf8mb4
# URL mysql:// từ dịch vụ MySQL và ?ssl-mode=REQUIRED được tự chuyển cho PyMySQL.
# Thay bằng khóa riêng ít nhất 32 ký tự trước khi chạy ứng dụng.
JWT_SECRET=replace-this-with-your-own-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
CORS_ORIGIN=http://127.0.0.1:4173,http://localhost:4173

# Seed mặc định có LEARNER và ADMIN mẫu trong app/db/seed.py.
# Tùy chọn: thêm ADMIN riêng bằng python -m app.db.seed --admin.
# Nếu bỏ trống các biến dưới, lệnh --admin sẽ hỏi email và mật khẩu.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
